@startuml atividade-desocupacao-e-saida
!include estilo.iuml
title Atividade: atalho "desocupar e sair"

|Especialista|
start
:Recusa a SAIR:
"ainda ocupa
a vaga …";
|Janela|
:Pergunta
"Desocupar …
e registrar
a saída?";
|Operador|
if (Responde
Sim?) then (não)
  stop
else (sim)
endif
|Janela|
:Envia
DESOCUPAR;
|Especialista|
if (Regras da
desocupação
respeitadas?) then (não)
  |Janela|
  :Mostra a recusa
  e não envia
  a saída;
  stop
else (sim)
endif
|Registro|
:Grava
DESOCUPAR;
|Janela|
:Envia SAIR;
|Especialista|
if (Regras da
saída
respeitadas?) then (sim)
  |Registro|
  :Grava SAIR;
else (não)
endif
|Janela|
:Mostra ✓ e o
tempo de
permanência,
ou a recusa;
stop
@enduml
