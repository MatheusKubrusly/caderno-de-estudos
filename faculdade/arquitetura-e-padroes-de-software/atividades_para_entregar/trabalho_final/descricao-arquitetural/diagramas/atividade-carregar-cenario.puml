@startuml atividade-carregar-cenario
!include estilo.iuml
title Atividade: carregar o cenário

|Administrador|
start
:Menu Dados >
Carregar
cenário;
if (Confirma?) then (não)
  stop
else (sim)
endif
|Registro|
:Copia o cenário
por cima de
eventos.csv;
|Blackboard|
:reiniciar() e
executarEmLote():
segura os avisos;
|Registro|
repeat
  if (Linha de
  dados bem
  formada?) then (sim)
    :Envia pela
    fachada, com
    o horário
    gravado;
    |Especialistas|
    :Conferem as
    regras e
    reescrevem
    o evento;
    |Registro|
    :Conta o aceito
    ou anota
    a recusa;
  else (não)
    :Pula a linha
    ou anota
    o problema;
  endif
repeat while (Há mais
linhas?) is (sim)
->não;
|Blackboard|
:Fim do lote:
avisa os
observers
uma vez;
|Administrador|
:Vê a nota
"2204 eventos
relidos.";
stop
@enduml
