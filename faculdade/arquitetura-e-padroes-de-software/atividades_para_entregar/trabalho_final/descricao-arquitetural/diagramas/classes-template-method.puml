@startuml classes-template-method
!include estilo.iuml
title Template Method nos especialistas (Knowledge Sources)

abstract class KnowledgeSource {
  # blackboard : Blackboard
  + run() : boolean <<final>>
  + nome() : String
  # sucesso(mensagem : String)
  # erro(mensagem : String)
  # {abstract} condition() : boolean
  # {abstract} execute()
}

abstract class EspecialistaDeSetor {
  # condition() : boolean <<final>>
  # execute() <<final>>
  # {abstract} setor() : Setor
  # problemaNaEntrada(r : Requisicao) : String
  # problemaNaOcupacao(r : Requisicao, v : Vaga) : String
  - entrar(r : Requisicao)
  - ocupar(r : Requisicao)
  - desocupar(r : Requisicao)
  - sair(r : Requisicao)
}

class ExternoKS {
  # setor() : Setor
}

class SubsoloKS {
  # setor() : Setor
  # problemaNaEntrada(r : Requisicao) : String
  # problemaNaOcupacao(r : Requisicao, v : Vaga) : String
}

class RelatorioKS {
  # condition() : boolean
  # execute()
}

class Estatisticas <<apoio, do pacote>> {
  media(...)
  esperasAteEstacionar(...)
  entradasPorHora(...)
  usoPorVaga(...)
  porPlaca(...)
}

KnowledgeSource <|-- EspecialistaDeSetor
KnowledgeSource <|-- RelatorioKS
EspecialistaDeSetor <|-- ExternoKS
EspecialistaDeSetor <|-- SubsoloKS
RelatorioKS ..> Estatisticas
@enduml
