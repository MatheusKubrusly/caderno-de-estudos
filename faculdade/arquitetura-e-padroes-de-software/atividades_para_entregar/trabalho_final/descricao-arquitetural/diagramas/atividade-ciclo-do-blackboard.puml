@startuml atividade-ciclo-do-blackboard
!include estilo.iuml
title Atividade: um ciclo do Blackboard

|Fachada|
start
:Recebe a requisição
e preenche o horário,
se faltar;
|Blackboard|
:Guarda como
pendente;
|Controlador|
repeat
  :Chama run() do
  próximo especialista;
  |Especialista|
  :run() chama
  condition() e, se
  true, execute():
  lê o Blackboard,
  confere as regras
  e escreve ou recusa;
  |Controlador|
repeat while (Devolveu
false e há
outro?) is (sim)
->não;
if (Algum devolveu
true?) then (não)
  :Publica "Nenhum
  especialista apto";
else (sim)
endif
|Blackboard|
:Guarda o resultado
e avisa os
observers;
|Controlador|
:Consome a
requisição;
|Fachada|
:Devolve o
resultado;
stop
@enduml
