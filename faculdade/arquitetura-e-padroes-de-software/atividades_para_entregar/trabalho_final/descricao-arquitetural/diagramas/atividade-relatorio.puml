@startuml atividade-relatorio
!include estilo.iuml
title Atividade: emitir um relatório

|Gerente|
start
:Escolhe um dos
11 relatórios (e
a placa ou o
período, se for
o caso) e clica
em "Gerar";
|Janela|
if (Placa e datas
no formato?) then (não)
  :Mostra a caixa
  "Formato
  inválido"
  (ex.: 31/02);
  stop
else (sim)
endif
:Envia
RELATORIO
pela fachada;
|Controlador|
:Pergunta a cada
especialista,
e só o RelatorioKS
aceita;
|RelatorioKS|
if (Alguma regra
violada?) then (sim)
  :Recusa pela 1ª
  regra violada:
  1. falta a placa
  2. falta o início
  ou o fim
  3. início depois
  do fim;
else (não)
  :Lê vagas e
  estadias e calcula
  com Estatisticas;
  :publicarRelatorio;
endif
|Janela|
:Mostra o
relatório ou
a recusa;
stop
@enduml
