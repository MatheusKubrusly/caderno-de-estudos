@startuml atividade-entrada
!include estilo.iuml
title Atividade: registrar a entrada

|Operador|
start
:Escolhe o setor,
digita a placa
(e a altura, no
Subsolo) e clica
em "Registrar
entrada";
|Janela|
if (Placa e altura
no formato?) then (não)
  :Mostra a caixa
  "Formato
  inválido";
  stop
else (sim)
endif
:Envia ENTRAR
pela fachada;
|Especialista|
if (Alguma regra
violada?) then (sim)
  :Recusa pela 1ª
  regra violada:
  1. placa vazia
  (CLI ou CSV)
  2. placa já está
  em algum setor
  3. horário antes
  do último
  evento da placa
  4. Subsolo:
  altura ausente
  ou > 2,10 m;
else (não)
  :registrarEntrada:
  estadia aberta,
  veículo
  circulando;
  |Registro|
  :Grava a linha
  ENTRAR
  no CSV;
endif
|Janela|
:Mostra ✓ ou ⚠
com a mensagem,
e, se aceito, limpa
os campos;
stop
@enduml
