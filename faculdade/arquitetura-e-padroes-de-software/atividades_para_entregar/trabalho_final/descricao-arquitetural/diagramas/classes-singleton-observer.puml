@startuml classes-singleton-observer
!include estilo.iuml
title Singleton e Observer no Blackboard

class Blackboard <<Singleton>> <<Subject>> {
  - {static} instancia : Blackboard
  - observers : List<Observer>
  - lotesAbertos : int
  - Blackboard()
  + {static} getInstance() : Blackboard
  + adicionarObserver(o : Observer)
  + removerObserver(o : Observer)
  + publicarResultado(r : ResultadoOperacao)
  + publicarRelatorio(r : Relatorio)
  + executarEmLote(tarefa : Runnable)
  + reiniciar()
  - notificarObservers()
}

interface Observer {
  + atualizar()
}

class JanelaPrincipal {
  + atualizar()
}
class Display {
  + atualizar()
}
class RegistroDeEventos {
  + atualizar()
}

Blackboard o--> "*" Observer : observers
JanelaPrincipal ..|> Observer
Display ..|> Observer
RegistroDeEventos ..|> Observer
@enduml
