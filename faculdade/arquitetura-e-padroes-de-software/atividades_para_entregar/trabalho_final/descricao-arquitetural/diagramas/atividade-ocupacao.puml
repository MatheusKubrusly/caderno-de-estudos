@startuml atividade-ocupacao
!include estilo.iuml
title Atividade: registrar a ocupação

|Sensor|
start
:Clica numa
vaga livre
(verde, ou azul
se preferencial);
|Janela|
if (Há veículo
circulando?) then (não)
  :Avisa
  "Registre uma
  entrada antes";
  stop
else (sim)
endif
:Abre a escolha
da placa (e do
motivo, se
preferencial);
|Sensor|
if (Confirma?) then (não)
  stop
else (sim)
endif
|Janela|
:Envia OCUPAR
pela fachada;
|Especialista|
if (Alguma regra
violada?) then (sim)
  :Recusa pela 1ª
  regra violada:
  1. não entrou
  neste setor
  2. já ocupa
  outra vaga
  3. vaga
  inexistente
  ou ocupada
  4. horário antes
  do último evento
  5. preferencial
  sem motivo;
else (não)
  :registrarOcupacao:
  vaga ocupada,
  veículo
  estacionado;
  |Registro|
  :Grava a linha
  OCUPAR
  no CSV;
endif
|Janela|
:Mostra ✓ ou ⚠,
e, se aceito, a vaga
fica vermelha;
stop
@enduml
